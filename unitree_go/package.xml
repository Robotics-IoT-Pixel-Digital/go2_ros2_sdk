<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>unitree_go</name>
  <version>0.0.0</version>
  <description>
    ROS 2 message interfaces for Go2 robot communication (merged unitree_go and go2_interfaces)
  </description>

  <maintainer email="miftahul@pixeldigital.ai">ubuntu</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Interface generation -->
  <build_depend>rosidl_default_generators</build_depend>
  <build_depend>geometry_msgs</build_depend>

  <!-- Runtime -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <!-- Required for interface-only packages -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Testing (optional but recommended) -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>